{
  "schema_version": 2,
  "id": "teacher-recovery-pilot",
  "label": "Actual-state teacher search -> unchanged independent admission -> conditional paired learning",
  "budget": {
    "max_wall_seconds": 18000,
    "max_sim_agent_steps": 10000000
  },
  "steps": [
    {
      "id": "student",
      "provider": "native_model_training_reference",
      "inputs": {},
      "config": {
        "source_task": "unified-driverl-v2",
        "source_stage": "resume"
      },
      "max_wall_seconds": 60
    },
    {
      "id": "select",
      "provider": "automatic_recovery_selection",
      "inputs": {
        "student": "student"
      },
      "config": {
        "scene": "../../../../../outputs/demonstrations/driverl-multicity-v1/log-03/prepared-final/scene.npz",
        "road_graph": "../../../../../outputs/demonstrations/driverl-multicity-v1/log-03/prepared-final/road-graph.json",
        "max_wall_seconds": 1800,
        "source_registry": "../sources/pittsburgh-recovery.json",
        "scout_steps": 300,
        "hard_failure_required": true,
        "perturbation": {
          "start_tick": 80,
          "duration_ticks": 15,
          "jerk_delta": 1.0,
          "lateral_delta": 0.4
        }
      },
      "max_wall_seconds": 1860
    },
    {
      "id": "correct",
      "provider": "same_anchor_counterfactual_correction",
      "inputs": {
        "selection": "select"
      },
      "config": {
        "max_wall_seconds": 1200,
        "backend": "native_recovery_search_v1"
      },
      "max_wall_seconds": 1260
    },
    {
      "id": "dataset",
      "provider": "online_recovery_curriculum",
      "inputs": {
        "selection": "select",
        "correction": "correct"
      },
      "config": {
        "request": "../../../training/lifecycle/driverl-active-recovery.json"
      },
      "max_wall_seconds": 60
    },
    {
      "id": "control-train",
      "provider": "curriculum_training",
      "inputs": {
        "dataset": "dataset"
      },
      "config": {
        "arm": "control"
      },
      "max_wall_seconds": 660
    },
    {
      "id": "control-resume",
      "provider": "curriculum_resume",
      "inputs": {
        "student": "control-train"
      },
      "config": {},
      "max_wall_seconds": 660
    },
    {
      "id": "control-evaluate",
      "provider": "curriculum_long_evaluation",
      "inputs": {
        "student": "control-resume"
      },
      "config": {
        "suite": "../../../evaluation/driverl_recovery_long.json",
        "max_wall_seconds": 3600
      },
      "max_wall_seconds": 3660
    },
    {
      "id": "treatment-train",
      "provider": "curriculum_training",
      "inputs": {
        "dataset": "dataset"
      },
      "config": {
        "arm": "treatment"
      },
      "max_wall_seconds": 660
    },
    {
      "id": "treatment-resume",
      "provider": "curriculum_resume",
      "inputs": {
        "student": "treatment-train"
      },
      "config": {},
      "max_wall_seconds": 660
    },
    {
      "id": "treatment-evaluate",
      "provider": "curriculum_long_evaluation",
      "inputs": {
        "student": "treatment-resume"
      },
      "config": {
        "suite": "../../../evaluation/driverl_recovery_long.json",
        "max_wall_seconds": 3600
      },
      "max_wall_seconds": 3660
    },
    {
      "id": "replay",
      "provider": "curriculum_resume",
      "inputs": {
        "student": "treatment-train"
      },
      "config": {},
      "max_wall_seconds": 660
    },
    {
      "id": "feedback",
      "provider": "curriculum_feedback",
      "inputs": {
        "control_student": "control-resume",
        "treatment_student": "treatment-resume",
        "control_evaluation": "control-evaluate",
        "treatment_evaluation": "treatment-evaluate",
        "replay": "replay",
        "dataset": "dataset"
      },
      "config": {},
      "max_wall_seconds": 60
    },
    {
      "id": "recollect",
      "provider": "promoted_hard_recovery_selection",
      "inputs": {
        "student": "treatment-resume",
        "feedback": "feedback"
      },
      "config": {
        "scene": "../../../../../outputs/demonstrations/driverl-multicity-v1/log-03/prepared-final/scene.npz",
        "road_graph": "../../../../../outputs/demonstrations/driverl-multicity-v1/log-03/prepared-final/road-graph.json",
        "max_wall_seconds": 1800,
        "source_registry": "../sources/pittsburgh-recovery.json",
        "scout_steps": 300,
        "hard_failure_required": true,
        "perturbation": {
          "start_tick": 80,
          "duration_ticks": 15,
          "jerk_delta": 1.0,
          "lateral_delta": 0.4
        }
      },
      "max_wall_seconds": 1860
    }
  ]
}
