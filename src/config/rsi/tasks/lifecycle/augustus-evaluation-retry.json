{
  "schema_version": 2,
  "id": "unified-augustus-evaluation-v3",
  "label": "Reuse completed AUGUstus training; retry native heldout evaluation and feedback only",
  "budget": {
    "max_wall_seconds": 3600,
    "max_sim_agent_steps": 640
  },
  "steps": [
    {
      "id": "resume",
      "provider": "native_model_training_reference",
      "inputs": {},
      "config": {
        "source_task": "unified-augustus-v1",
        "source_stage": "resume"
      },
      "max_wall_seconds": 300
    },
    {
      "id": "replay",
      "provider": "native_model_training_reference",
      "inputs": {},
      "config": {
        "source_task": "unified-augustus-v1",
        "source_stage": "replay"
      },
      "max_wall_seconds": 300
    },
    {
      "id": "evaluation",
      "provider": "native_model_unified_evaluation",
      "inputs": {
        "student": "resume"
      },
      "config": {
        "request": "../../../training/lifecycle/augustus.json",
        "evaluator": "../../../../../exp/unified-learning-v1/augustus-evaluator.json"
      },
      "max_wall_seconds": 1800
    },
    {
      "id": "feedback",
      "provider": "native_model_unified_feedback",
      "inputs": {
        "student": "resume",
        "replay": "replay",
        "evaluation": "evaluation"
      },
      "config": {},
      "max_wall_seconds": 300
    }
  ]
}
